---
// Página individual de un proyecto (Work) o de un workshop: misma estructura para ambos.
import Layout from '../layouts/Layout.astro'
import Img from './Img.astro'
import MediaWall from './MediaWall.astro'
import type { WallRow } from './MediaWall.astro'
import { getProjects, getWorkshops, slugOf, urlFor } from '../lib/sanity'
import { fmtRole, excerpt } from '../lib/labels'
import { fmtLinkLabel, fmtSector, href, langOf, loc, slugFor, ui } from '../lib/i18n'

interface Props {
  project: any
  section: 'work' | 'workshops'
}

const { project, section } = Astro.props
const isWorkshop = section === 'workshops'

const lang = langOf(Astro.url)
const other = lang === 'en' ? 'es' : 'en'
const T = ui[lang]

const title = loc(project, 'title', lang)
const context = loc(project, 'contextAndChallenge', lang)
const solution = loc(project, 'solution', lang)
const results = loc(project, 'results', lang)
const credits = (project.credits ?? []).filter((c: any) => c?.role_en || c?.role_es)

// Muestras y reconocimientos, por año descendente (mismo formato que en About)
const byYearDesc = (a: any, b: any) => (b.year ?? 0) - (a.year ?? 0)
const screenings = (project.screenings ?? []).filter((s: any) => s?.title).sort(byYearDesc)
const awards = (project.awards ?? []).filter((a: any) => a?.title).sort(byYearDesc)

// Dos columnas (texto | resultados) solo si hay ambas cosas; si no, una sola.
const twoCol = (context || solution) && results?.length > 0

// Imágenes válidas (descarta las que quedaron sin asset subido en Sanity)
const gallery = (project.gallery ?? []).filter((item: any) => item?.asset || item?.videoUrl)

// Trabajos de estudiantes: cada uno es un bloque con título, autores y su fila de piezas
const workRows: WallRow[] = (project.works ?? [])
  .map((work: any) => ({
    groups: ['works'],
    title: work.title,
    meta: work.authors,
    link: work.link,
    items: (work.items ?? [])
      .filter((item: any) => item?.asset || item?.videoUrl)
      .map((item: any) => {
        const caption = [work.title, work.authors].filter(Boolean).join(' — ')
        return item.videoUrl
          ? { kind: 'video', groups: ['works'], videoUrl: item.videoUrl, poster: item.poster, title: caption }
          : { kind: 'image', groups: ['works'], image: item, title: caption }
      }),
  }))
  .filter((row: WallRow) => row.items.length > 0)

// Los workshops se etiquetan con tags; los proyectos, con role
const roles = ((isWorkshop ? project.tags : project.role) ?? []).map((r: string) => fmtRole(r, lang))
const back = isWorkshop
  ? { href: href('/workshops', lang), label: T.nav.workshops }
  : { href: href('/', lang), label: T.nav.work }
// Esta misma página en el otro idioma (cada idioma tiene su propio slug)
const base = isWorkshop ? '/workshops' : '/work'
const altHref = href(`${base}/${slugFor(project, other)}`, other)

// Proyecto anterior y siguiente, en el mismo orden de la grilla (da la vuelta en los extremos)
const siblings = (await (isWorkshop ? getWorkshops() : getProjects())).filter(slugOf)
const here = siblings.findIndex((s: any) => s._id === project._id)
const pick = (step: number) =>
  here < 0 || siblings.length < 2 ? undefined : siblings[(here + step + siblings.length) % siblings.length]
const around = [
  { dir: 'prev', label: `← ${T.previous}`, entry: pick(-1) },
  { dir: 'next', label: `${T.next} →`, entry: pick(1) },
]
  .filter((s) => s.entry)
  .map((s) => ({
    ...s,
    title: loc(s.entry, 'title', lang),
    href: href(`${base}/${slugFor(s.entry, lang)}`, lang),
    thumb: s.entry.coverImage?.asset
      ? urlFor(s.entry.coverImage).width(264).height(165).fit('crop').auto('format').url()
      : undefined,
  }))

// ── SEO ────────────────────────────────────────────────────
const description =
  excerpt(context ?? solution) ||
  `${title}${roles.length ? ` — ${roles.join(', ')}` : ''}${project.year ? ` (${project.year})` : ''}. ${isWorkshop ? T.aWorkshop : T.aProject} ${T.by} Eloísa Nieto.`
const shareImage = project.coverImage
  ? urlFor(project.coverImage).width(1200).height(630).fit('crop').auto('format').url()
  : undefined
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  ...(project.year ? { dateCreated: String(project.year) } : {}),
  ...(shareImage ? { image: shareImage } : {}),
  ...(roles.length ? { genre: roles } : {}),
  creator: { '@type': 'Person', name: 'Eloísa Nieto' },
}

let imageCount = 0
---

<Layout title={`${title} — Eloísa Nieto`} description={description} image={shareImage} type="article" jsonLd={jsonLd} section={section} headline={loc(project, 'headline', lang)} altHref={altHref}>
  <!-- Navegación entre proyectos: en desktop va en la columna izquierda -->
  <nav slot="sidebar" class="entry-nav in-sidebar" aria-label={T.backTo + ' ' + back.label}>
    <a class="entry-back" href={back.href} data-grid-back>← {T.backTo} {back.label}</a>
    {around.length > 0 && (
      <div class="entry-around">
        {around.map((s) => (
          <a class="entry-sib" href={s.href} rel={s.dir}>
            {s.thumb && <img src={s.thumb} alt="" width="132" height="82" decoding="async" />}
            <span class="sib-text">
              <span class="sib-dir">{s.label}</span>
              <span class="sib-title">{s.title}</span>
            </span>
          </a>
        ))}
      </div>
    )}
  </nav>

  <article class="project">

    <!-- Portada a ancho completo (hero) -->
    {project.coverImage && (
      <figure class="project-cover">
        <Img
          image={project.coverImage}
          alt={title}
          ratio={16 / 7}
          widths={[640, 1000, 1400, 2000]}
          sizes="(max-width: 1000px) 100vw, calc(100vw - 524px)"
          eager
        />
      </figure>
    )}

    <!-- Bloque de información: título, año, créditos, intro y resultados juntos -->
    <div class="project-info">

      <header class="project-head">
        <h1 class="project-title">{title}</h1>
        {project.year && <span class="project-year">{project.year}</span>}
      </header>

      <!-- Ficha de créditos -->
      <div class="project-meta">
        {roles.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">{isWorkshop ? T.type : T.role}</span>
            <span class="meta-value">{roles.join(', ')}</span>
          </div>
        )}
        {project.sector?.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">{T.sector}</span>
            <span class="meta-value">{project.sector.map((s: string) => fmtSector(s, lang)).join(', ')}</span>
          </div>
        )}
        {project.agency && (
          <div class="meta-item">
            <span class="meta-label">{isWorkshop ? T.institution : T.agency}</span>
            <span class="meta-value">{project.agency}</span>
          </div>
        )}
        {project.link && (
          <div class="meta-item">
            <span class="meta-label">{fmtLinkLabel(project.linkLabel, lang)}</span>
            <a class="meta-value meta-link" href={project.link} target="_blank" rel="noopener">
              {T.visit}
              <span class="arrow-swap">
                <span>↗</span>
                <span>↗</span>
              </span>
            </a>
          </div>
        )}
      </div>

      <!-- Texto y resultados: dos columnas si hay ambos, una si no -->
      {((context || solution) || results?.length > 0) && (
        <div class={twoCol ? 'project-detail two-col' : 'project-detail'}>
          {(context || solution) && (
            <div class="project-intro">
              {context && <p>{context}</p>}
              {solution && <p>{solution}</p>}
            </div>
          )}

          {results?.length > 0 && (
            <div class="project-results">
              <span class="meta-label">{T.results}</span>
              <ul class="results-list">
                {results.map((r: string) => <li>{r}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}

    </div>

    <!-- Trabajos de estudiantes, uno por bloque -->
    {workRows.length > 0 && (
      <div class="project-works">
        <MediaWall items={[]} rows={workRows} label={title} />
      </div>
    )}

    <!-- Resto de la galería, hasta el final -->
    {gallery.length > 0 && (
      <div class="project-gallery">
        {gallery.map((item: any) => {
          const caption = lang === 'es' ? item.caption_es || item.caption : item.caption || item.caption_es
          const isVideo = item._type === 'galleryVideo' || item?.videoUrl
          const isNarrow = isVideo ? item.isPortrait : item.halfWidth
          const isMp4 = isVideo && /\.(mp4|webm|ogg)(\?.*)?$/i.test(item.videoUrl ?? '')
          if (!isVideo) imageCount++
          return (
            <figure class={isNarrow ? 'gallery-item narrow' : 'gallery-item'}>
              {isVideo ? (
                isMp4 ? (
                  <button
                    class="gallery-open"
                    type="button"
                    aria-label={`${T.open}: ${caption ?? `${title} — video`}`}
                    data-kind="video"
                    data-full={item.videoUrl}
                    data-caption={caption}
                  >
                    <video src={item.videoUrl} autoplay muted loop playsinline preload="metadata" aria-label={caption ?? `${title} — video`} />
                  </button>
                ) : (
                  <iframe src={item.videoUrl} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" title={caption ?? 'Video'} />
                )
              ) : (
                <button
                  class="gallery-open"
                  type="button"
                  aria-label={`${T.open}: ${caption ?? `${title} — ${T.image} ${imageCount}`}`}
                  data-full={urlFor(item).width(2400).auto('format').quality(85).url()}
                  data-caption={caption}
                >
                  <Img
                    image={item}
                    alt={caption ?? `${title} — ${T.image} ${imageCount}`}
                    widths={[640, 960, 1400, 2000]}
                    sizes={isNarrow
                      ? '(max-width: 700px) 100vw, (max-width: 1000px) 50vw, calc((100vw - 548px) / 2)'
                      : '(max-width: 1000px) 100vw, calc(100vw - 524px)'}
                  />
                </button>
              )}
              {caption && <figcaption>{caption}</figcaption>}
            </figure>
          )
        })}
      </div>
    )}

    <!-- Muestras y reconocimientos, editables desde el CMS -->
    {screenings.length > 0 && (
      <section class="project-rows">
        <h2 class="meta-label">{T.screenings}</h2>
        <ul class="rows-list">
          {screenings.map((s: any) => (
            <li class="row">
              <span class="row-year">{s.year}</span>
              <span class="row-name">{s.title}</span>
              <span class="row-place">{[s.venue, s.city].filter(Boolean).join(', ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {awards.length > 0 && (
      <section class="project-rows">
        <h2 class="meta-label">{T.awards}</h2>
        <ul class="rows-list">
          {awards.map((a: any) => (
            <li class="row">
              <span class="row-year">{a.year}</span>
              <span class="row-name">{a.title}</span>
              <span class="row-place">{a.detail}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Créditos, editables desde el CMS -->
    {credits.length > 0 && (
      <section class="project-credits">
        <span class="meta-label">{T.credits}</span>
        <div class="credits-grid">
          {credits.map((c: any) => (
            <div class="credit-item">
              <span class="credit-role">{loc(c, 'role', lang)}</span>
              {(c.names ?? []).map((n: string) => (
                <span class="credit-name">{n}</span>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Volver -->
    <!-- En móvil la misma navegación va al final de la página -->
    <nav class="entry-nav at-end" aria-label={T.backTo + ' ' + back.label}>
      <a class="entry-back" href={back.href} data-grid-back>← {T.backTo} {back.label}</a>
      {around.length > 0 && (
        <div class="entry-around">
          {around.map((s) => (
            <a class="entry-sib" href={s.href} rel={s.dir}>
              {s.thumb && <img src={s.thumb} alt="" width="132" height="82" loading="lazy" decoding="async" />}
              <span class="sib-text">
                <span class="sib-dir">{s.label}</span>
                <span class="sib-title">{s.title}</span>
              </span>
            </a>
          ))}
        </div>
      )}
    </nav>

  </article>

  <!-- Visor: la imagen en grande -->
  <dialog class="entry-viewer" aria-label={T.viewer} data-lenis-prevent>
    <div class="viewer-bar">
      <span class="viewer-count" aria-live="polite"></span>
      <button class="viewer-btn" type="button" data-action="close">{T.close}</button>
    </div>
    <div class="viewer-stage"></div>
    <div class="viewer-foot">
      <p class="viewer-caption"></p>
      <div class="viewer-nav">
        <button class="viewer-btn" type="button" data-action="prev" aria-label={T.previous}>←</button>
        <button class="viewer-btn" type="button" data-action="next" aria-label={T.next}>→</button>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .project {
    width: 100%;
  }

  /* PORTADA HERO */
  .project-cover {
    margin-bottom: 2.5rem;
  }


  /* BLOQUE DE INFORMACIÓN */
  .project-info {
    margin-bottom: 3.5rem;
  }

  /* TÍTULO + AÑO */
  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .project-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--indigo);
  }

  .project-year {
    font-size: 1.0625rem;
    color: var(--lila);
  }

  /* FICHA DE CRÉDITOS */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 0.5px solid var(--lila);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.8125rem;
    color: var(--lila);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta-value {
    font-size: 1.0625rem;
    color: var(--indigo);
  }

  .meta-link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    border-bottom: 0.5px solid var(--indigo);
    padding-bottom: 0.05rem;
  }

  .meta-link:hover {
    border-bottom-color: transparent;
  }

  /* Flecha que sale por arriba-derecha y vuelve a entrar desde abajo-izquierda */
  .arrow-swap {
    position: relative;
    display: inline-block;
    width: 1em;
    height: 1em;
    overflow: hidden;
  }

  .arrow-swap span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* la segunda flecha arranca escondida en la esquina abajo-izquierda */
  .arrow-swap span:nth-child(2) {
    transform: translate(-100%, 100%);
  }

  .meta-link:hover .arrow-swap span:nth-child(1) {
    transform: translate(100%, -100%);
  }

  .meta-link:hover .arrow-swap span:nth-child(2) {
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow-swap span { transition: none; }
  }

  /* TEXTO + RESULTADOS */
  .project-detail.two-col {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 380px);
    justify-content: space-between;
    gap: 3rem;
    align-items: start;
  }

  .project-detail.two-col .project-intro {
    max-width: none;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .project-detail.two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* INTRO BREVE */
  .project-intro {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }

  .project-intro p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--indigo);
  }

  /* GALERÍA — el protagonista */
  .project-works {
    margin-top: 3rem;
  }

  .project-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  /* Por defecto cada imagen ocupa todo el ancho (horizontales y cuadradas) */
  .gallery-item {
    width: 100%;
  }

  /* Las verticales ocupan media fila, así se acomodan de a dos */
  .gallery-item.narrow {
    width: calc(50% - 0.75rem);
  }

  .gallery-item video,
  .gallery-item iframe {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    border: none;
    background: #000;
  }

  .gallery-item.narrow video,
  .gallery-item.narrow iframe {
    aspect-ratio: 9 / 16;
  }

  /* Los videos propios toman su proporción real apenas cargan (16:9 o 9:16 es solo
     la reserva de espacio inicial), así nunca quedan con franjas negras. */
  .gallery-item video {
    aspect-ratio: auto 16 / 9;
    height: auto;
    background: color-mix(in srgb, var(--lila) 14%, transparent);
  }

  .gallery-item.narrow video {
    aspect-ratio: auto 9 / 16;
  }

  /* la imagen es un botón que abre el visor */
  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    font: inherit;
    color: inherit;
    text-align: inherit;
  }

  .gallery-open:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 4px;
  }

  /* VISOR (mismo comportamiento que el de Art y Misc) */
  .entry-viewer {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.25rem 2rem 1.5rem 1.75rem;
    border: none;
    background: transparent;
    color: var(--indigo);
    font-family: var(--font);
    overflow: hidden;
  }

  .entry-viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
  }

  .entry-viewer::backdrop { background: transparent; }

  /* El fondo es una capa aparte para poder fundirlo de 0 a 100 al abrir */
  .entry-viewer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    opacity: 0;
    transition: opacity 0.42s ease;
  }

  .entry-viewer.is-open::before { opacity: 1; }

  .entry-viewer .viewer-bar,
  .entry-viewer .viewer-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .entry-viewer .viewer-foot { align-items: flex-end; }

  .entry-viewer.is-open .viewer-bar,
  .entry-viewer.is-open .viewer-foot {
    opacity: 1;
    transition-delay: 0.14s;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-viewer::before,
    .entry-viewer .viewer-bar,
    .entry-viewer .viewer-foot { transition: none; }
  }

  .entry-viewer .viewer-count { font-size: 1.25rem; color: var(--lila); }

  .entry-viewer .viewer-caption {
    font-size: 1.0625rem;
    line-height: 1.4;
    min-height: 1.4em;
  }

  .entry-viewer .viewer-nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .entry-viewer .viewer-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    font-size: 1.25rem;
    color: var(--indigo);
    padding: 0;
    line-height: 1.1;
  }

  .entry-viewer .viewer-btn:hover {
    text-decoration: underline;
    text-underline-offset: 0px;
    text-decoration-thickness: 0.12em;
    text-decoration-skip-ink: none;
  }

  .entry-viewer .viewer-btn:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 4px;
  }

  .entry-viewer .viewer-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    cursor: zoom-out;
  }

  .entry-viewer .viewer-stage :global(img),
  .entry-viewer .viewer-stage :global(video) {
    display: block;
    object-fit: contain;
    cursor: default;
  }

  @media (max-width: 1000px) {
    .entry-viewer { padding: 1.1rem var(--gutter) 1.25rem; }
  }

  .gallery-item figcaption {
    font-size: 0.875rem;
    color: var(--lila);
    margin-top: 0.5rem;
  }

  /* En pantallas chicas, las verticales también pasan a fila completa */
  @media (max-width: 700px) {
    .gallery-item.narrow { width: 100%; }
  }

  /* Animación de entrada al scrollear (solo si el JS la activa) */
  .project-gallery.reveal .gallery-item {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  /* las verticales que van de a dos entran una después de la otra */
  .project-gallery.reveal .gallery-item.narrow + .gallery-item.narrow {
    transition-delay: 0.12s;
  }

  .project-gallery.reveal .gallery-item.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Anterior / Siguiente entran igual que las imágenes de la galería.
     En la columna izquierda ya están a la vista al cargar, así que la entrada es
     una animación CSS que parte desde el primer pintado (sin esperar al JS). */
  @keyframes sib-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .entry-nav.in-sidebar .entry-sib {
    animation: sib-in 0.7s ease 0.2s both;
  }

  .entry-nav.in-sidebar .entry-sib + .entry-sib {
    animation-delay: 0.32s;
  }

  /* Al final de la página (móvil) entran al llegar con el scroll */
  .entry-around.reveal .entry-sib {
    opacity: 0;
    transform: translateY(28px);
  }

  .entry-around.reveal .entry-sib.in-view {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.7s ease, transform 0.7s ease, color 0.2s ease;
  }

  .entry-around.reveal .entry-sib + .entry-sib.in-view {
    transition-delay: 0.12s, 0.12s, 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-gallery.reveal .gallery-item,
    .entry-around.reveal .entry-sib {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .entry-nav.in-sidebar .entry-sib { animation: none; }
  }

  /* RESULTADOS — cierre liviano */
  .project-results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .results-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .results-list li {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--indigo);
    padding-left: 1.3rem;
    position: relative;
  }

  .results-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--lila);
  }

  /* CRÉDITOS */
  .project-credits {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  /* MUESTRAS Y RECONOCIMIENTOS — mismas filas que Exhibitions en About */
  .project-rows {
    margin-bottom: 3.5rem;
  }

  .project-rows .meta-label {
    display: block;
    font-weight: 400;
    padding-bottom: 0.75rem;
    border-bottom: 0.5px solid var(--lila);
  }

  .rows-list {
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 0.5px solid var(--lila);
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--indigo);
  }

  .row-year {
    color: var(--lila);
    font-variant-numeric: tabular-nums;
  }

  .row-place {
    color: var(--lila);
    text-align: right;
  }

  @media (max-width: 700px) {
    /* año a la izquierda; título y lugar apilados */
    .row {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: 0.1rem 0.75rem;
      font-size: 1rem;
    }

    .row-place {
      grid-column: 2;
      text-align: left;
    }
  }

  .credits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, max-content));
    gap: 1.75rem 3rem;
  }

  .credit-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .credit-role {
    font-size: 0.8125rem;
    color: var(--lila);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .credit-name {
    font-size: 1.0625rem;
    color: var(--indigo);
    line-height: 1.4;
  }

  /* NAVEGACIÓN: volver + anterior / siguiente */
  .entry-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry-back {
    font-size: 1rem;
    color: var(--lila);
    align-self: flex-start;
    transition: color 0.2s ease;
  }

  .entry-back:hover { color: var(--indigo); }

  .entry-around {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .entry-sib {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--lila);
    transition: color 0.2s ease;
  }

  .entry-sib img {
    width: 88px;
    height: 55px;
    object-fit: cover;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--lila) 18%, transparent);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .sib-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .sib-dir { font-size: 0.8125rem; }

  .sib-title {
    font-size: 1rem;
    color: var(--indigo);
    line-height: 1.2;
    text-wrap: balance;
  }

  .entry-sib:hover { color: var(--indigo); }
  .entry-sib:hover img { opacity: 1; }

  /* en desktop solo se ve la de la columna izquierda */
  .entry-nav.at-end { display: none; }

  @media (max-width: 1000px) {
    .entry-nav.in-sidebar { display: none; }
    .entry-nav.at-end {
      display: flex;
      padding-top: 1.75rem;
      border-top: 0.5px solid var(--lila);
    }
    .entry-nav.at-end .entry-around {
      flex-direction: row;
      gap: 1rem;
    }
    .entry-nav.at-end .entry-sib {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .entry-nav.at-end .entry-sib img {
      width: 100%;
      height: auto;
      aspect-ratio: 8 / 5;
    }
    .entry-nav.at-end .entry-sib[rel='next'] { text-align: right; align-items: flex-end; }
  }

  @media (max-width: 1000px) {
    .project-gallery { gap: 1rem; }
    .project-cover { margin-bottom: 1.75rem; }
    .project-info { margin-bottom: 2.5rem; }
    .project-head { margin-bottom: 1.5rem; }
    .project-meta { gap: 1.1rem 2rem; }
  }
</style>

<script>
  // "Volver": avisa a la grilla que debe restaurar el punto donde se quedó
  document.querySelectorAll<HTMLAnchorElement>('[data-grid-back]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        sessionStorage.setItem('grid:restore', new URL(a.href).pathname.replace(/\/+$/, '') || '/')
      } catch (e) {}
    })
  })

  const gallery = document.querySelector('.project-gallery')

  if (gallery && 'IntersectionObserver' in window) {
    // activa el estado inicial (oculto) solo si hay JS, para que sin JS las imágenes se vean igual
    gallery.classList.add('reveal')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    )

    gallery.querySelectorAll('.gallery-item').forEach((item) => observer.observe(item))
  }

  // Anterior / Siguiente al final de la página (móvil): misma entrada que las imágenes.
  // Los de la columna izquierda se animan solo con CSS.
  if ('IntersectionObserver' in window) {
    const sibObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view')
            sibObserver.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.12 }
    )
    document.querySelectorAll('.entry-nav.at-end .entry-around').forEach((group) => {
      group.classList.add('reveal')
      group.querySelectorAll('.entry-sib').forEach((sib) => sibObserver.observe(sib))
    })
  }

  // ── Visor: la imagen viaja entre su lugar en la página y el centro ──
  const viewer = document.querySelector<HTMLDialogElement>('.entry-viewer')
  const openers = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-open'))

  if (viewer && openers.length > 0) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const stage = viewer.querySelector<HTMLElement>('.viewer-stage')!
    const captionEl = viewer.querySelector<HTMLElement>('.viewer-caption')!
    const countEl = viewer.querySelector<HTMLElement>('.viewer-count')!
    const navEl = viewer.querySelector<HTMLElement>('.viewer-nav')!
    const EASE = 'cubic-bezier(0.2, 0.7, 0.2, 1)'
    let current = -1
    let closing: number | undefined

    navEl.hidden = openers.length < 2

    function show(index: number) {
      current = (index + openers.length) % openers.length
      const opener = openers[current]
      captionEl.textContent = opener.dataset.caption ?? ''
      countEl.textContent = openers.length > 1 ? `${current + 1} / ${openers.length}` : ''

      // lo más grande que cabe en el escenario con la proporción de la imagen
      stage.replaceChildren()
      const thumb = opener.getBoundingClientRect()
      const box = stage.getBoundingClientRect()
      const ratio = thumb.height > 0 ? thumb.width / thumb.height : 1
      const width = Math.min(box.width, box.height * ratio)

      const full = opener.dataset.full ?? ''
      const fit = (el: HTMLElement) => {
        el.style.width = `${Math.round(width)}px`
        el.style.height = `${Math.round(width / ratio)}px`
      }

      // el video de la página se detiene mientras se ve en grande
      document.querySelectorAll<HTMLVideoElement>('.gallery-item video').forEach((v) => v.pause())

      if (opener.dataset.kind === 'video') {
        // en grande va con controles y sigue desde donde iba en la página
        const inline = opener.querySelector('video')
        const video = document.createElement('video')
        video.src = full
        video.controls = true
        video.playsInline = true
        video.loop = true
        video.muted = true
        video.autoplay = true
        if (inline) video.currentTime = inline.currentTime
        fit(video)
        stage.append(video)
        return
      }

      const img = document.createElement('img')
      const small = opener.querySelector('img')
      img.alt = small?.alt ?? ''
      if (small?.currentSrc && small.naturalWidth > 0) {
        // se ve de inmediato con la versión de la página y se cambia por la grande al cargar
        img.src = small.currentSrc
        const big = new Image()
        big.onload = () => {
          if (img.isConnected) img.src = full
        }
        big.src = full
      } else {
        img.src = full
      }
      fit(img)
      stage.append(img)
    }

    // transform que lleva la imagen del visor a calzar sobre la de la página
    function toThumb(media: HTMLElement, opener: HTMLElement) {
      const from = opener.getBoundingClientRect()
      const to = media.getBoundingClientRect()
      if (to.width === 0 || to.height === 0) return 'none'
      return `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`
    }

    function openViewer(opener: HTMLButtonElement) {
      window.clearTimeout(closing)
      viewer!.showModal()
      show(openers.indexOf(opener))
      const media = stage.firstElementChild as HTMLElement | null
      if (media && !reduceMotion) {
        media.animate(
          [
            { transformOrigin: 'top left', transform: toThumb(media, opener) },
            { transformOrigin: 'top left', transform: 'none' },
          ],
          { duration: 420, easing: EASE }
        )
      }
      // fuerza un reflow para que el fundido del fondo parta desde 0
      void viewer!.offsetWidth
      viewer!.classList.add('is-open')
    }

    function closeViewer() {
      if (!viewer!.open) return
      const opener = openers[current]
      const media = stage.firstElementChild as HTMLElement | null
      viewer!.classList.remove('is-open')
      if (reduceMotion || !media || !opener) {
        viewer!.close()
        return
      }
      if (media instanceof HTMLVideoElement) media.pause()
      // si se avanzó a otra imagen, la página se mueve para que vuelva a su lugar
      const r = opener.getBoundingClientRect()
      if (r.bottom < 0 || r.top > window.innerHeight) opener.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior })
      media.animate(
        [
          { transformOrigin: 'top left', transform: 'none' },
          { transformOrigin: 'top left', transform: toThumb(media, opener) },
        ],
        { duration: 260, easing: EASE, fill: 'forwards' }
      )
      window.clearTimeout(closing)
      closing = window.setTimeout(() => viewer!.close(), 260)
    }

    openers.forEach((opener) => opener.addEventListener('click', () => openViewer(opener)))

    // Esc cierra con la misma animación
    viewer.addEventListener('cancel', (event) => {
      event.preventDefault()
      closeViewer()
    })

    window.addEventListener('resize', () => {
      if (viewer.open) show(current)
    })

    viewer.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      const action = target.closest<HTMLElement>('[data-action]')?.dataset.action
      if (action === 'close') closeViewer()
      else if (action === 'prev') show(current - 1)
      else if (action === 'next') show(current + 1)
      // click en el espacio vacío alrededor de la imagen: cierra
      else if (target === stage) closeViewer()
    })

    viewer.addEventListener('keydown', (event) => {
      if (openers.length < 2) return
      if (event.key === 'ArrowLeft') show(current - 1)
      if (event.key === 'ArrowRight') show(current + 1)
    })

    viewer.addEventListener('close', () => {
      viewer.classList.remove('is-open')
      stage.replaceChildren()
      // los videos de la página que están a la vista vuelven a andar
      document.querySelectorAll<HTMLVideoElement>('.gallery-item video').forEach((v) => {
        const r = v.getBoundingClientRect()
        if (r.bottom > 0 && r.top < window.innerHeight) v.play().catch(() => {})
      })
      const opener = openers[current]
      // la imagen queda visible aunque todavía no hubiera entrado con el scroll
      opener?.closest('.gallery-item')?.classList.add('in-view')
      opener?.focus({ preventScroll: true })
    })
  }

  // Los videos solo se reproducen mientras están en pantalla
  // (ahorra batería y datos, sobre todo en el teléfono).
  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement
          if (entry.isIntersecting && !document.querySelector<HTMLDialogElement>('.entry-viewer')?.open) video.play().catch(() => {})
          else video.pause()
        })
      },
      { threshold: 0.1 }
    )
    document.querySelectorAll<HTMLVideoElement>('.gallery-item video').forEach((v) => videoObserver.observe(v))
  }
</script>