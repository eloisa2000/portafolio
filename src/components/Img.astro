---
// Imagen de Sanity con srcset, tamaño reservado (sin saltos de layout)
// y entrada suave: se ve primero una miniatura borrosa (lqip) y la imagen
// real aparece con un fundido cuando termina de cargar.
import { urlFor } from '../lib/sanity'

interface Props {
  image: any
  alt: string
  widths?: number[]
  sizes?: string
  /** ancho / alto. Si se pasa, la imagen se recorta a esa proporción. */
  ratio?: number
  eager?: boolean
  class?: string
  [key: string]: any
}

const {
  image,
  alt,
  widths = [640, 960, 1400, 2000],
  sizes = '100vw',
  ratio,
  eager = false,
  class: cls,
  ...rest
} = Astro.props

// Si la imagen tiene un recorte hecho en el CMS, sus dimensiones originales ya no sirven.
const natural = image?.crop ? undefined : image?.dims?.aspectRatio
const r = ratio ?? natural

function make(w: number) {
  let b = urlFor(image).width(w).auto('format').quality(80)
  if (ratio) b = b.height(Math.round(w / ratio)).fit('crop')
  return b.url()
}

const srcset = widths.map((w) => `${make(w)} ${w}w`).join(', ')
const baseW = widths[Math.min(1, widths.length - 1)]

const style = [
  r ? `aspect-ratio:${r}` : '',
  image?.lqip ? `background-image:url(${image.lqip})` : '',
].filter(Boolean).join(';')
---

<span class:list={['img-frame', cls]} style={style} {...rest}>
  <img
    src={make(baseW)}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={r ? baseW : undefined}
    height={r ? Math.round(baseW / r) : undefined}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</span>
