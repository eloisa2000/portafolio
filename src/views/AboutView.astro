---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro'
import Img from '../components/Img.astro'
import { getProfile } from '../lib/sanity'
import { excerpt } from '../lib/labels'
import { langOf, loc, ui } from '../lib/i18n'

const lang = langOf(Astro.url)
const T = ui[lang]

const profile = await getProfile()
const name = profile?.name ?? 'Eloísa Nieto'

const aboutTitle = loc(profile, 'aboutTitle', lang) ?? T.about
// El texto viene como un solo bloque; cada línea en blanco separa un párrafo
const paragraphs = (loc(profile, 'aboutText', lang) ?? '')
  .split(/\n\s*\n/)
  .map((p: string) => p.replace(/\s+/g, ' ').trim())
  .filter(Boolean)

const likesTitle = loc(profile, 'likesTitle', lang) ?? T.likes
const likes = (loc(profile, 'likes', lang) ?? []).filter((l: string) => l && l.trim().length > 0)

// Las dos imágenes del final (pueden ser 0, 1 o 2 según lo que cargues en Sanity)
const aboutImages = (profile?.aboutImages ?? []).filter((img: any) => img?.asset)

// Exhibitions & Screenings: solo las del perfil, en el orden en que están en Sanity.
// Las proyecciones de un proyecto (p. ej. Glorp Corp) se muestran solo en su página.
const exhibitions = (profile?.exhibitions ?? []).filter((e: any) => e?.title)

const description = excerpt(paragraphs.join(' ')) || undefined
---

<Layout title={`${T.about} — ${name}`} description={description} type="profile">
  <div class="about-page">
    <h1 class="about-title">{aboutTitle}</h1>

    {(paragraphs.length > 0 || likes.length > 0) && (
      <div class={paragraphs.length > 0 && likes.length > 0 ? 'about-detail two-col' : 'about-detail'}>
        {paragraphs.length > 0 && (
          <div class="about-text">
            {paragraphs.map((p: string) => <p>{p}</p>)}
          </div>
        )}

        {likes.length > 0 && (
          <section class="likes-section">
            <h2 class="section-label">{likesTitle}</h2>
            <ul class="likes-list">
              {likes.map((item: string) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}

    {aboutImages.length > 0 && (
      <div class={`about-images ${aboutImages.length === 1 ? 'single' : ''}`}>
        {aboutImages.map((img: any) => (
          <figure class="about-image">
            <Img
              image={img}
              alt={img.caption ?? name}
              widths={[640, 960, 1400]}
              sizes={aboutImages.length === 1 ? '(max-width: 1000px) 100vw, 720px' : '(max-width: 700px) 100vw, 50vw'}
            />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    {exhibitions.length > 0 && (
      <section class="exhibitions-section">
        <h2 class="section-label">{T.exhibitions}</h2>
        <ul class="exhibitions-list">
          {exhibitions.map((e: any) => (
            <li class="exhibition-row">
              <span class="exhibition-year">{e.year}</span>
              <span class="exhibition-name">{e.title}</span>
              <span class="exhibition-place">{[e.venue, e.city].filter(Boolean).join(', ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

<style>
  .about-page {
    width: 100%;
    padding-bottom: 2rem;
  }

  /* mismo tamaño que el título de las páginas de proyecto */
  .about-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    color: var(--indigo);
    line-height: 1.05;
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 0.5px solid var(--lila);
  }

  /* TEXTO + LIKES: dos columnas, igual que texto + resultados en los proyectos */
  .about-detail.two-col {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 380px);
    justify-content: space-between;
    gap: 3rem;
    align-items: start;
  }

  .about-text {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .about-text p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--indigo);
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--lila);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .likes-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .likes-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .about-images.single {
    grid-template-columns: 1fr;
    max-width: 720px;
  }

  .about-image figcaption {
    font-size: 0.875rem;
    color: var(--lila);
    margin-top: 0.5rem;
  }

  /* ── Exhibitions & Screenings ─────────────────── */
  .exhibitions-section {
    margin-top: 4rem;
  }

  .exhibitions-section .section-label {
    padding-bottom: 0.75rem;
    border-bottom: 0.5px solid var(--lila);
  }

  .exhibitions-list {
    list-style: none;
  }

  .exhibition-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 0.5px solid var(--lila);
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--indigo);
  }

  .exhibition-year {
    color: var(--lila);
    font-variant-numeric: tabular-nums;
  }

  .exhibition-place {
    color: var(--lila);
    text-align: right;
  }

  @media (max-width: 1300px) {
    .about-detail.two-col {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 700px) {
    .about-title {
      padding-bottom: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .about-images {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 2.5rem;
    }

    .exhibitions-section {
      margin-top: 3rem;
    }

    /* año a la izquierda; título y lugar apilados */
    .exhibition-row {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: 0.1rem 0.75rem;
      font-size: 1rem;
    }

    .exhibition-place {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
