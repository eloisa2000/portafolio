---
// src/pages/work/[slug].astro
import Layout from '../../layouts/Layout.astro'
import { getProject, getProjects, urlFor } from '../../lib/sanity'

export async function getStaticPaths() {
  const projects = await getProjects()
  return projects
    .filter((p: any) => p.slug_en?.current || p.slug_es?.current)
    .map((p: any) => ({
      params: { slug: p.slug_en?.current ?? p.slug_es?.current },
    }))
}

const { slug } = Astro.params
// busca por slug_en primero, luego slug_es como fallback
const project = await (async () => {
  const byEn = await import('../../lib/sanity').then(m =>
    m.client.fetch(
      `*[_type == "project" && slug_en.current == $slug][0]{
        _id, title_en, title_es, slug_en, slug_es,
        year, agency, role, sector,
        contextAndChallenge_en, solution_en, results_en,
        contextAndChallenge_es, solution_es, results_es,
        gallery[]{ _type, _key, caption, asset, videoUrl, isPortrait, halfWidth },
        link, linkLabel, coverImage,
        credits[]{ role_en, role_es, names }
      }`,
      { slug }
    )
  )
  if (byEn) return byEn
  return import('../../lib/sanity').then(m =>
    m.client.fetch(
      `*[_type == "project" && slug_es.current == $slug][0]{
        _id, title_en, title_es, slug_en, slug_es,
        year, agency, role, sector,
        contextAndChallenge_en, solution_en, results_en,
        contextAndChallenge_es, solution_es, results_es,
        gallery[]{ _type, _key, caption, asset, videoUrl, isPortrait, halfWidth },
        link, linkLabel, coverImage,
        credits[]{ role_en, role_es, names }
      }`,
      { slug }
    )
  )
})()

if (!project) return Astro.redirect('/work')

const title = project.title_en ?? project.title_es
const context = project.contextAndChallenge_en ?? project.contextAndChallenge_es
const solution = project.solution_en ?? project.solution_es
const results = project.results_en ?? project.results_es
const credits = (project.credits ?? []).filter((c: any) => c?.role_en || c?.role_es)

// Dos columnas (texto | resultados) solo si hay ambas cosas; si no, una sola.
const twoCol = (context || solution) && results?.length > 0

// Solo los roles vienen como slugs (web-design, ui-design...) y hay que formatearlos.
// Los sectores ya vienen como label ("Arts & Culture", "E-Commerce") y se muestran tal cual.
const roleLabels: Record<string, string> = {
  'web-design': 'Web Design',
  'ui-design': 'UI Design',
  'brand-identity': 'Brand Identity',
  'graphic-design': 'Graphic Design',
  'art-direction': 'Art Direction',
  'motion-design': 'Motion Design',
  'development': 'Development',
  'ux-research': 'UX Research',
  'community-management': 'Community Management',
  'type-design': 'Type Design',
  'lettering': 'Lettering',
}

function fmtRole(val: string) {
  return roleLabels[val] ?? val.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}

// Imágenes válidas (descarta las que quedaron sin asset subido en Sanity)
const gallery = (project.gallery ?? []).filter((item: any) => item?.asset || item?.videoUrl)
---

<Layout title={`${title} — Eloísa Nieto`}>
  <article class="project">

    <!-- Portada a ancho completo (hero) -->
    {project.coverImage && (
      <figure class="project-cover">
        <img src={urlFor(project.coverImage).width(2000).height(875).fit('crop').url()} alt={title} />
      </figure>
    )}

    <!-- Bloque de información: título, año, créditos, intro y resultados juntos -->
    <div class="project-info">

      <header class="project-head">
        <h1 class="project-title">{title}</h1>
        {project.year && <span class="project-year">{project.year}</span>}
      </header>

      <!-- Ficha de créditos -->
      <div class="project-meta">
        {project.role?.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">Role</span>
            <span class="meta-value">{project.role.map(fmtRole).join(', ')}</span>
          </div>
        )}
        {project.sector?.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">Sector</span>
            <span class="meta-value">{project.sector.join(', ')}</span>
          </div>
        )}
        {project.agency && (
          <div class="meta-item">
            <span class="meta-label">Agency</span>
            <span class="meta-value">{project.agency}</span>
          </div>
        )}
        {project.link && (
          <div class="meta-item">
            <span class="meta-label">{project.linkLabel ?? 'Site'}</span>
            <a class="meta-value meta-link" href={project.link} target="_blank" rel="noopener">
              Visit
              <span class="arrow-swap">
                <span>↗</span>
                <span>↗</span>
              </span>
            </a>
          </div>
        )}
      </div>

      <!-- Texto y resultados: dos columnas si hay ambos, una si no -->
      {((context || solution) || results?.length > 0) && (
        <div class={twoCol ? 'project-detail two-col' : 'project-detail'}>
          {(context || solution) && (
            <div class="project-intro">
              {context && <p>{context}</p>}
              {solution && <p>{solution}</p>}
            </div>
          )}

          {results?.length > 0 && (
            <div class="project-results">
              <span class="meta-label">Results</span>
              <ul class="results-list">
                {results.map((r: string) => <li>{r}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}

    </div>

    <!-- Resto de la galería, hasta el final -->
    {gallery.length > 0 && (
      <div class="project-gallery">
        {gallery.map((item: any) => {
          const isVideo = item._type === 'galleryVideo' || item?.videoUrl
          const isNarrow = isVideo ? item.isPortrait : item.halfWidth
          const isMp4 = isVideo && /\.(mp4|webm|ogg)(\?.*)?$/i.test(item.videoUrl ?? '')
          return (
            <figure class={isNarrow ? 'gallery-item narrow' : 'gallery-item'}>
              {isVideo ? (
                isMp4 ? (
                  <video src={item.videoUrl} autoplay muted loop playsinline />
                ) : (
                  <iframe src={item.videoUrl} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" title={item.caption ?? 'Video'} />
                )
              ) : (
                <img src={urlFor(item).width(1600).url()} alt={item.caption ?? ''} loading="lazy" />
              )}
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          )
        })}
      </div>
    )}

    <!-- Créditos, editables desde el CMS -->
    {credits.length > 0 && (
      <section class="project-credits">
        <span class="meta-label">Credits</span>
        <div class="credits-grid">
          {credits.map((c: any) => (
            <div class="credit-item">
              <span class="credit-role">{c.role_en ?? c.role_es}</span>
              {(c.names ?? []).map((n: string) => (
                <span class="credit-name">{n}</span>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Volver -->
    <div class="project-nav">
      <a href="/">← Back to Work</a>
    </div>

  </article>
</Layout>

<style>
  .project {
    width: 100%;
  }

  /* PORTADA HERO */
  .project-cover {
    margin-bottom: 2.5rem;
  }

  .project-cover img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    display: block;
  }

  /* BLOQUE DE INFORMACIÓN */
  .project-info {
    margin-bottom: 3.5rem;
  }

  /* TÍTULO + AÑO */
  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .project-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--indigo);
  }

  .project-year {
    font-size: 1.0625rem;
    color: var(--lila);
  }

  /* FICHA DE CRÉDITOS */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 0.5px solid var(--lila);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.8125rem;
    color: var(--lila);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta-value {
    font-size: 1.0625rem;
    color: var(--indigo);
  }

  .meta-link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    border-bottom: 0.5px solid var(--indigo);
    padding-bottom: 0.05rem;
  }

  .meta-link:hover {
    border-bottom-color: transparent;
  }

  /* Flecha que sale por arriba-derecha y vuelve a entrar desde abajo-izquierda */
  .arrow-swap {
    position: relative;
    display: inline-block;
    width: 1em;
    height: 1em;
    overflow: hidden;
  }

  .arrow-swap span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* la segunda flecha arranca escondida en la esquina abajo-izquierda */
  .arrow-swap span:nth-child(2) {
    transform: translate(-100%, 100%);
  }

  .meta-link:hover .arrow-swap span:nth-child(1) {
    transform: translate(100%, -100%);
  }

  .meta-link:hover .arrow-swap span:nth-child(2) {
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow-swap span { transition: none; }
  }

  /* TEXTO + RESULTADOS */
  .project-detail.two-col {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 380px);
    justify-content: space-between;
    gap: 3rem;
    align-items: start;
  }

  .project-detail.two-col .project-intro {
    max-width: none;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .project-detail.two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* INTRO BREVE */
  .project-intro {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }

  .project-intro p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--indigo);
  }

  /* GALERÍA — el protagonista */
  .project-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  /* Por defecto cada imagen ocupa todo el ancho (horizontales y cuadradas) */
  .gallery-item {
    width: 100%;
  }

  /* Las verticales ocupan media fila, así se acomodan de a dos */
  .gallery-item.narrow {
    width: calc(50% - 0.75rem);
  }

  .gallery-item img {
    width: 100%;
    display: block;
  }

  .gallery-item video,
  .gallery-item iframe {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    border: none;
    background: #000;
  }

  .gallery-item.narrow video,
  .gallery-item.narrow iframe {
    aspect-ratio: 9 / 16;
  }

  .gallery-item figcaption {
    font-size: 0.875rem;
    color: var(--lila);
    margin-top: 0.5rem;
  }

  /* En pantallas chicas, las verticales también pasan a fila completa */
  @media (max-width: 700px) {
    .gallery-item.narrow { width: 100%; }
  }

  /* Animación de entrada al scrollear (solo si el JS la activa) */
  .project-gallery.reveal .gallery-item {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .project-gallery.reveal .gallery-item.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-gallery.reveal .gallery-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* RESULTADOS — cierre liviano */
  .project-results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .results-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .results-list li {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--indigo);
    padding-left: 1.3rem;
    position: relative;
  }

  .results-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--lila);
  }

  /* CRÉDITOS */
  .project-credits {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .credits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, max-content));
    gap: 1.75rem 3rem;
  }

  .credit-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .credit-role {
    font-size: 0.8125rem;
    color: var(--lila);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .credit-name {
    font-size: 1.0625rem;
    color: var(--indigo);
    line-height: 1.4;
  }

  /* VOLVER */
  .project-nav {
    padding-top: 1.75rem;
    border-top: 0.5px solid var(--lila);
  }

  .project-nav a {
    font-size: 1rem;
    color: var(--lila);
  }

  .project-nav a:hover {
    color: var(--indigo);
  }

  @media (max-width: 1000px) {
    .project-gallery { gap: 1rem; }
  }
</style>

<script>
  const gallery = document.querySelector('.project-gallery')

  if (gallery && 'IntersectionObserver' in window) {
    // activa el estado inicial (oculto) solo si hay JS, para que sin JS las imágenes se vean igual
    gallery.classList.add('reveal')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    )

    gallery.querySelectorAll('.gallery-item').forEach((item) => observer.observe(item))
  }
</script>