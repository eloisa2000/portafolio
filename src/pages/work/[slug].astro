---
import EntryPage from '../../components/EntryPage.astro'
import { getProjects, getEntry, slugOf } from '../../lib/sanity'

export async function getStaticPaths() {
  const entries = await getProjects()
  return entries.filter(slugOf).map((entry: any) => ({ params: { slug: slugOf(entry) } }))
}

const { slug } = Astro.params
const entry = await getEntry('project', slug!)

if (!entry) return Astro.redirect('/')
---

<EntryPage project={entry} section="work" />
