---
import ProjectsPage from '../components/ProjectsPage.astro'
import { getProjects, isWorkshop } from '../lib/sanity'

// Workshops: los proyectos que tienen el rol "workshops" en Sanity
const projects = (await getProjects()).filter(isWorkshop)
---

<ProjectsPage
  projects={projects}
  title="Workshops — Eloísa Nieto"
  description="Workshops by Eloísa Nieto on interactive design, the web and digital culture."
  section="workshops"
  label="Workshops"
/>
