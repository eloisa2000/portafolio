---
import ProjectsPage from '../components/ProjectsPage.astro'
import { getProjects, isWork } from '../lib/sanity'

// Work: todos los proyectos salvo los que son solo workshops
const projects = (await getProjects()).filter(isWork)
---

<ProjectsPage
  projects={projects}
  title="Eloísa Nieto — Web & UI Designer in Santiago, Chile"
  section="work"
  label="Selected work"
  headlineAsH1
/>
