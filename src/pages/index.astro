---
import Layout from '../layouts/Layout.astro'
import { getProjects, urlFor } from '../lib/sanity'

const projects = await getProjects()

const roleOrder = ['web-design', 'ui-design', 'brand-identity', 'graphic-design', 'art-direction', 'motion-design', 'development', 'workshops']
const sectorOrder = ['Arts & Culture', 'Social Impact', 'Education', 'Health', 'B2B', 'Industry', 'Tech', 'E-Commerce']
const rolesInUse = new Set(projects.flatMap((p: any) => p.role ?? []))
const sectorsInUse = new Set(projects.flatMap((p: any) => p.sector ?? []))

const allRoles = roleOrder.filter(r => rolesInUse.has(r))
const allSectors = sectorOrder.filter(s => sectorsInUse.has(s))

const labelMap: Record<string, string> = {
  'ui-design': 'UI Design',
  'web-design': 'Web Design',
  'art-direction': 'Art Direction',
  'branding': 'Branding',
  'brand-identity': 'Brand Identity',
  'development': 'Development',
  'ux-research': 'UX Research',
  'graphic-design': 'Graphic Design',
  'motion-design': 'Motion Design',
  'community-management': 'Community Management',
  'b2b': 'B2B',
  'education': 'Education',
  'culture': 'Art & Culture',
  'health': 'Health',
  'tech': 'Tech',
  'social-impact': 'Social Impact',
  'ecommerce': 'E Commerce',
  'industry': 'Industry',
}

function fmt(val: string) {
  return labelMap[val] ?? val.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}
---

<Layout title="Eloísa Nieto">

  <div slot="sidebar" class="filters">
    <div class="filter-group left">
      <ul class="filter-list">
        {allRoles.map((role: any) => (
          <li>
            <button class="filter-btn" data-filter="role" data-value={role}>{fmt(role)}</button>
          </li>
        ))}
        <li><button class="filter-btn active" data-filter="role" data-value="all">All</button></li>
      </ul>
    </div>

    <div class="filter-group right">
      <ul class="filter-list">
        {allSectors.map((sector: any) => (
          <li>
            <button class="filter-btn" data-filter="sector" data-value={sector}>{fmt(sector)}</button>
          </li>
        ))}
        <li><button class="filter-btn active" data-filter="sector" data-value="all">All</button></li>
      </ul>
    </div>
  </div>

  <noscript>
    <style>.project-card { opacity: 1 !important; transform: none !important; }</style>
  </noscript>

  <section class="projects-grid">
    {projects.map((project: any) => (
      <article
        class="project-card"
        data-role={project.role?.join(',')}
        data-sector={project.sector?.join(',')}
      >
        <a href={`/work/${project.slug_en?.current ?? project.slug_es?.current}`}>
          {project.coverImage ? (
            <img
              src={urlFor(project.coverImage).width(900).height(580).fit('crop').url()}
              alt={project.title_en ?? project.title_es}
              class="project-cover"
              loading="lazy"
            />
          ) : (
            <div class="project-cover placeholder" />
          )}
          <div class="project-meta">
            <span class="project-year">{project.year}</span>
            <div class="project-tags">
              {project.role?.map((r: string) => (
                <span class="tag">{fmt(r)}</span>
              ))}
            </div>
          </div>
          <h2 class="project-title">{project.title_en ?? project.title_es}</h2>
        </a>
      </article>
    ))}
  </section>
</Layout>

<style>
  .filters {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .filter-group.right {
    text-align: right;
  }

  .filter-group.right .filter-btn {
    text-align: right;
    width: 100%;
  }

  .filter-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .filter-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    font-size: 1.5rem;
    color: var(--lila);
    padding: 0;
    text-align: left;
    white-space: nowrap;
    line-height: 1.1;
  }

  .filter-btn.active { color: var(--indigo); }

  .filter-btn:hover {
    text-decoration: underline;
    text-underline-offset: 0px;
    text-decoration-thickness: 0.12em;
    text-decoration-skip-ink: none;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
  }

  @media (max-width: 1300px) {
    .projects-grid { grid-template-columns: 1fr; }
  }

  .project-card a {
    display: block;
  }

  .project-title:hover {
    text-decoration: underline;
    text-underline-offset: 0px;
    text-decoration-thickness: 0.12em;
    text-decoration-skip-ink: none;
  }

  .project-cover {
    width: 100%;
    aspect-ratio: 677 / 437;
    object-fit: cover;
    display: block;
    margin-bottom: 0.65rem;
  }

  .project-cover.placeholder {
    background: #d9d9d9;
    aspect-ratio: 677 / 437;
    margin-bottom: 0.65rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.1rem;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-year { font-size: 1rem; color: var(--indigo); }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .project-title {
    font-size: 1.6rem;
    font-weight: 400;
    text-align: left;
    line-height: 1.15;
    color: var(--indigo);
    width: 100%;
  }
  
  @media (max-width: 1000px) {
  .page-body { grid-template-columns: 1fr; }
  .top-nav { grid-template-columns: 1fr auto auto; gap: 1rem; }
  .sidebar {
    position: static;
    height: auto;
  }
  .sidebar-footer { display: none; }
  .main-content { padding: 1.5rem 1rem; }

  /* Foto y bio juntas */
  .profile-header {
    justify-content: flex-start;
    gap: 1rem;
  }

  .profile-bio {
    width: auto;
    max-width: 100%;
  }

  /* Ocultar filtros del sidebar */
.filters {
  display: none;
}
}

.project-card {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

/* revelada al entrar en vista */
.project-card.in-view {
  opacity: 1;
  transform: translateY(0);
}

/* el filtrado debe ganarle al estado revelado: va despues en el codigo */
.project-card.hidden {
  opacity: 0;
  transform: translateY(8px);
  pointer-events: none;
  position: absolute;
  visibility: hidden;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

@media (prefers-reduced-motion: reduce) {
  .project-card {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

  
</style>

<script>
  const buttons = document.querySelectorAll('.filter-btn')
const cards = document.querySelectorAll('.project-card')

let activeRole = 'all'
let activeSector = 'all'

function applyFilters() {
  cards.forEach((card) => {
    const roles = card.dataset.role?.split(',') ?? []
    const sectors = card.dataset.sector?.split(',') ?? []
    const roleMatch = activeRole === 'all' || roles.includes(activeRole)
    const sectorMatch = activeSector === 'all' || sectors.includes(activeSector)

    if (roleMatch && sectorMatch) {
      card.classList.remove('hidden')
    } else {
      card.classList.add('hidden')
    }
  })
}

function updateActiveButtons() {
  // Marca como activo el botón correspondiente en cada grupo
  document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'))
  document.querySelector(`.filter-btn[data-filter="role"][data-value="${activeRole}"]`)?.classList.add('active')
  document.querySelector(`.filter-btn[data-filter="sector"][data-value="${activeSector}"]`)?.classList.add('active')
}

buttons.forEach((btn) => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter
    const value = btn.dataset.value

    if (filter === 'role') {
      activeRole = value
      activeSector = 'all'  // resetea Sector
    }
    if (filter === 'sector') {
      activeSector = value
      activeRole = 'all'  // resetea Role
    }

    updateActiveButtons()
    applyFilters()
  })
})

// Animación de entrada al scrollear (igual que en las páginas de proyecto)
if ('IntersectionObserver' in window) {
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view')
          revealObserver.unobserve(entry.target)
        }
      })
    },
    { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
  )
  cards.forEach((card) => revealObserver.observe(card))
} else {
  // sin soporte, mostrar todo de una
  cards.forEach((card) => card.classList.add('in-view'))
}
</script>