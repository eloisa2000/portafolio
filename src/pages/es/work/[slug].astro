---
// Versión en español de la página de un proyecto: usa el slug en español.
import EntryPage from '../../../components/EntryPage.astro'
import { getProjects, getEntry } from '../../../lib/sanity'
import { slugFor } from '../../../lib/i18n'

export async function getStaticPaths() {
  const entries = await getProjects()
  return entries
    .filter((entry: any) => slugFor(entry, 'es'))
    .map((entry: any) => ({ params: { slug: slugFor(entry, 'es') } }))
}

const { slug } = Astro.params
const entry = await getEntry('project', slug!)

if (!entry) return Astro.redirect('/es')
---

<EntryPage project={entry} section="work" />
