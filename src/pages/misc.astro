---
// Misc: un espacio para mirar imágenes y videos sueltos, en columnas.
// El contenido se edita en Sanity (documento "Misc").
import Layout from '../layouts/Layout.astro'
import MediaWall, { type WallItem } from '../components/MediaWall.astro'
import WallFilters from '../components/WallFilters.astro'
import { getMisc, urlFor } from '../lib/sanity'

const misc = await getMisc()

const items: WallItem[] = (misc?.items ?? [])
  // descarta lo que quedó sin archivo subido en Sanity
  .filter((item: any) => (item._type === 'miscVideo' ? item.videoUrl : item.asset))
  .map((item: any) =>
    item._type === 'miscVideo'
      ? { kind: 'video', groups: ['video'], videoUrl: item.videoUrl, poster: item.poster, title: item.caption, year: item.year }
      : { kind: 'image', groups: ['image'], image: item, title: item.caption, year: item.year }
  )

const hasImages = items.some((item) => item.kind === 'image')
const hasVideos = items.some((item) => item.kind === 'video')

const firstImage = items.find((item) => item.kind === 'image')?.image
const shareImage = firstImage
  ? urlFor(firstImage).width(1200).height(630).fit('crop').auto('format').url()
  : undefined
---

<Layout
  title="Misc — Eloísa Nieto"
  description="Loose images and videos by Eloísa Nieto: posters, animations and other odds and ends."
  image={shareImage}
  section="misc"
>

  <div slot="sidebar" class="wall-side">
    {misc?.intro_en && <p class="wall-intro">{misc.intro_en}</p>}
    {hasImages && hasVideos && (
      <WallFilters
        label="Filter by type"
        active="all"
        options={[
          { value: 'all', label: 'All' },
          { value: 'image', label: 'Images' },
          { value: 'video', label: 'Videos' },
        ]}
      />
    )}
  </div>

  <h1 class="visually-hidden">Misc</h1>

  {items.length === 0 && <p class="empty-note">Nothing here yet.</p>}

  <MediaWall items={items} label="Loose images and videos" />
</Layout>

<style>
  .empty-note {
    font-size: 1.0625rem;
    color: var(--lila);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .wall-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .wall-intro {
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--lila);
    max-width: 22rem;
  }

  @media (max-width: 1000px) {
    .wall-side { gap: 0; }
    .wall-intro { padding-top: 1rem; }
  }
</style>
