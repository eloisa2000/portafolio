---
// Misc: un espacio para mirar imágenes y videos sueltos, en columnas.
// El contenido se edita en Sanity (documento "Misc").
import Layout from '../layouts/Layout.astro'
import Img from '../components/Img.astro'
import { getMisc, urlFor } from '../lib/sanity'

const misc = await getMisc()

// Descarta lo que quedó sin archivo subido en Sanity
const items = (misc?.items ?? []).filter((item: any) =>
  item._type === 'miscVideo' ? item.videoUrl : item.asset
)

const isVideo = (item: any) => item._type === 'miscVideo'
const hasImages = items.some((item: any) => !isVideo(item))
const hasVideos = items.some(isVideo)

// Ancho de cada columna según el layout (ver CSS más abajo)
const SIZES = '(max-width: 1000px) 50vw, (max-width: 1500px) calc((100vw - 540px) / 2), calc((100vw - 572px) / 3)'

const fullUrl = (image: any) => urlFor(image).width(2400).auto('format').quality(85).url()
const posterUrl = (image: any) => urlFor(image).width(960).auto('format').quality(75).url()

const firstImage = items.find((item: any) => !isVideo(item))
const shareImage = firstImage
  ? urlFor(firstImage).width(1200).height(630).fit('crop').auto('format').url()
  : undefined
---

<Layout
  title="Misc — Eloísa Nieto"
  description="Loose images and videos by Eloísa Nieto: posters, animations and other odds and ends."
  image={shareImage}
  section="misc"
>

  <div slot="sidebar" class="misc-side">
    {misc?.intro_en && <p class="misc-intro">{misc.intro_en}</p>}
    {hasImages && hasVideos && (
      <ul class="kind-list" aria-label="Filter by type">
        <li><button class="kind-btn active" data-kind="all" aria-pressed="true">All</button></li>
        <li><button class="kind-btn" data-kind="image" aria-pressed="false">Images</button></li>
        <li><button class="kind-btn" data-kind="video" aria-pressed="false">Videos</button></li>
      </ul>
    )}
  </div>

  <h1 class="visually-hidden">Misc</h1>

  {items.length === 0 && <p class="empty-note">Nothing here yet.</p>}

  <section class="misc-wall" aria-label="Loose images and videos">
    {items.map((item: any, i: number) => {
      const video = isVideo(item)
      const label = item.caption || (video ? 'Video' : 'Image')
      const ratio = video ? item.poster?.dims?.aspectRatio : undefined
      return (
        <figure class="misc-item" data-kind={video ? 'video' : 'image'}>
          <button
            class="misc-open"
            type="button"
            aria-label={`Open ${label}`}
            data-full={video ? item.videoUrl : fullUrl(item)}
            data-poster={video && item.poster?.asset ? posterUrl(item.poster) : undefined}
            data-caption={item.caption}
            data-year={item.year}
          >
            {video ? (
              <span
                class="img-frame misc-video-frame"
                style={[
                  ratio ? `aspect-ratio:${ratio}` : '',
                  item.poster?.lqip ? `background-image:url(${item.poster.lqip})` : '',
                ].filter(Boolean).join(';')}
              >
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={item.poster?.asset ? posterUrl(item.poster) : undefined}
                  data-src={item.videoUrl}
                  aria-hidden="true"
                  tabindex="-1"
                ></video>
              </span>
            ) : (
              <Img
                image={item}
                alt={item.caption ?? ''}
                widths={[320, 480, 720, 960, 1400]}
                sizes={SIZES}
                eager={i < 3}
              />
            )}
          </button>
          {(item.caption || item.year) && (
            <figcaption>
              {item.caption && <span>{item.caption}</span>}
              {item.year && <span class="misc-year">{item.year}</span>}
            </figcaption>
          )}
        </figure>
      )
    })}
  </section>

  <!-- Visor: la imagen o el video en grande, con sonido y controles -->
  <dialog class="misc-viewer" aria-label="Viewer" data-lenis-prevent>
    <div class="viewer-bar">
      <span class="viewer-count" aria-live="polite"></span>
      <button class="viewer-btn" type="button" data-action="close">Close</button>
    </div>
    <div class="viewer-stage"></div>
    <div class="viewer-foot">
      <p class="viewer-caption"></p>
      <div class="viewer-nav">
        <button class="viewer-btn" type="button" data-action="prev" aria-label="Previous">←</button>
        <button class="viewer-btn" type="button" data-action="next" aria-label="Next">→</button>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .empty-note {
    font-size: 1.0625rem;
    color: var(--lila);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* SIDEBAR */
  .misc-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .misc-intro {
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--lila);
    max-width: 22rem;
  }

  .kind-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .kind-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    font-size: 1.5rem;
    color: var(--lila);
    padding: 0;
    text-align: left;
    line-height: 1.1;
  }

  .kind-btn.active { color: var(--indigo); }

  .kind-btn:hover {
    text-decoration: underline;
    text-underline-offset: 0px;
    text-decoration-thickness: 0.12em;
    text-decoration-skip-ink: none;
  }

  /* MURO — columnas de alto libre: cada pieza conserva su proporción */
  .misc-wall {
    columns: 3;
    column-gap: 1.5rem;
  }

  @media (max-width: 1500px) {
    .misc-wall { columns: 2; }
  }

  .misc-item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  .misc-item[hidden] { display: none; }

  .misc-open {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    font: inherit;
    color: inherit;
  }

  .misc-open:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 3px;
  }

  .misc-video-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .misc-item figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.45rem;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--indigo);
  }

  .misc-year { color: var(--lila); margin-left: auto; }

  /* VISOR */
  .misc-viewer {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.25rem 2rem 1.5rem 1.75rem;
    border: none;
    background: var(--bg);
    color: var(--indigo);
    font-family: var(--font);
    overflow: hidden;
  }

  .misc-viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
  }

  .misc-viewer::backdrop { background: var(--bg); }

  .viewer-bar,
  .viewer-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }

  .viewer-count { font-size: 1.25rem; color: var(--lila); }

  .viewer-caption {
    font-size: 1.0625rem;
    line-height: 1.4;
    min-height: 1.4em;
  }

  .viewer-nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .viewer-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    font-size: 1.25rem;
    color: var(--indigo);
    padding: 0;
    line-height: 1.1;
  }

  .viewer-btn:hover {
    text-decoration: underline;
    text-underline-offset: 0px;
    text-decoration-thickness: 0.12em;
    text-decoration-skip-ink: none;
  }

  .viewer-btn:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 4px;
  }

  .viewer-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    cursor: zoom-out;
  }

  .viewer-stage :global(img),
  .viewer-stage :global(video) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: default;
  }

  @media (max-width: 1000px) {
    .misc-side {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      padding-top: 1rem;
    }

    .kind-list {
      flex-direction: row;
      gap: 1rem;
    }

    .kind-btn { font-size: 1.25rem; }

    .misc-wall,
    .misc-item { column-gap: 1rem; }

    .misc-item { margin-bottom: 1rem; }

    .misc-viewer { padding: 1.1rem var(--gutter) 1.25rem; }
  }

  @media (max-width: 520px) {
    .misc-side { flex-direction: column; gap: 0.75rem; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  const figures = Array.from(document.querySelectorAll<HTMLElement>('.misc-item'))
  const openers = figures.map((f) => f.querySelector<HTMLButtonElement>('.misc-open')!)

  // ── Videos del muro: sin sonido, y solo andan mientras están a la vista ──
  const wallVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('.misc-video-frame video'))

  wallVideos.forEach((video) => {
    video.addEventListener('loadeddata', () => video.closest('.img-frame')?.classList.add('is-settled'), { once: true })
  })

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement
          if (entry.isIntersecting && !viewer?.open) {
            if (!video.src && video.dataset.src) video.src = video.dataset.src
            video.play().catch(() => {})
          } else {
            video.pause()
          }
        })
      },
      { rootMargin: '200px 0px' }
    )
    wallVideos.forEach((video) => observer.observe(video))
  }

  // ── Filtro por tipo ──
  const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.kind-btn'))
  kindButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const kind = btn.dataset.kind
      kindButtons.forEach((b) => {
        const on = b === btn
        b.classList.toggle('active', on)
        b.setAttribute('aria-pressed', String(on))
      })
      figures.forEach((f) => {
        f.hidden = kind !== 'all' && f.dataset.kind !== kind
      })
    })
  })

  // ── Visor ──
  const viewer = document.querySelector<HTMLDialogElement>('.misc-viewer')
  const stage = viewer?.querySelector<HTMLElement>('.viewer-stage')
  const captionEl = viewer?.querySelector<HTMLElement>('.viewer-caption')
  const countEl = viewer?.querySelector<HTMLElement>('.viewer-count')
  let current = -1

  // Solo se recorren las piezas visibles con el filtro actual
  const visible = () => openers.filter((_, i) => !figures[i].hidden)

  function show(index: number) {
    if (!viewer || !stage) return
    const list = visible()
    if (list.length === 0) return
    current = (index + list.length) % list.length
    const opener = list[current]
    const isVideo = opener.closest('.misc-item')?.getAttribute('data-kind') === 'video'

    stage.replaceChildren()
    if (isVideo) {
      const video = document.createElement('video')
      video.src = opener.dataset.full ?? ''
      if (opener.dataset.poster) video.poster = opener.dataset.poster
      video.controls = true
      video.playsInline = true
      video.loop = true
      video.autoplay = true
      stage.append(video)
    } else {
      const img = document.createElement('img')
      img.src = opener.dataset.full ?? ''
      img.alt = opener.dataset.caption ?? ''
      stage.append(img)
    }

    if (captionEl) {
      captionEl.textContent = [opener.dataset.caption, opener.dataset.year].filter(Boolean).join(', ')
    }
    if (countEl) countEl.textContent = `${current + 1} / ${list.length}`
  }

  function open(opener: HTMLButtonElement) {
    if (!viewer) return
    wallVideos.forEach((v) => v.pause())
    viewer.showModal()
    show(visible().indexOf(opener))
  }

  openers.forEach((opener) => opener.addEventListener('click', () => open(opener)))

  viewer?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement
    const action = target.closest<HTMLElement>('[data-action]')?.dataset.action
    if (action === 'close') viewer.close()
    else if (action === 'prev') show(current - 1)
    else if (action === 'next') show(current + 1)
    // click en el espacio vacío alrededor de la pieza: cierra
    else if (target === stage) viewer.close()
  })

  viewer?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1)
    if (event.key === 'ArrowRight') show(current + 1)
  })

  viewer?.addEventListener('close', () => {
    const opener = visible()[current]
    // al cerrar se corta el video (y su sonido) y vuelven a andar los del muro
    stage?.replaceChildren()
    if (!reduceMotion) {
      wallVideos.forEach((v) => {
        const r = v.getBoundingClientRect()
        if (v.src && r.bottom > 0 && r.top < window.innerHeight) v.play().catch(() => {})
      })
    }
    opener?.focus({ preventScroll: true })
  })
</script>
